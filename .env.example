# ── MySQL（本项目独立容器）──
MYSQL_PORT=23307
MYSQL_ROOT_PASSWORD=aws_root_9f3b2c
MYSQL_DATABASE=agent_work_system
MYSQL_APP_PASSWORD=aws_app_7k4m8x

# ── Qdrant（本项目独立容器）──
QDRANT_PORT=26334

# ── API ──
API_PORT=8900

# ── LLM（Anthropic 兼容 API，必填才走真实模型；留空则用 mock）──
ANTHROPIC_BASE_URL=https://model.rhdata.cn
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── 向量/重排模型 Provider：hashing | tei | openai ──
# hashing：内置零依赖实现（开发联调）；tei/openai：接本地 bge-m3 / bge-reranker
# ── 向量/重排模型 Provider ──
# 本地模型服务随 docker compose 自动启动（服务名 model-service，容器端口 8090）
# 未配置模型时可改回 hashing + DIM=256 走零依赖占位模式（并移除 compose 中 model-service 依赖）
EMBEDDING_PROVIDER=tei
EMBEDDING_DIM=1024
EMBEDDING_API_BASE=http://model-service:8090
EMBEDDING_MODEL=bge-m3
RERANK_PROVIDER=tei
RERANK_API_BASE=http://model-service:8090
RERANK_MODEL=bge-reranker-large
# 宿主机本地 ONNX 模型目录（映射到容器 /models，只读）
MODEL_DIR=D:/EmbedingModel

# ── A2A 对外暴露 ──
# 外部系统访问本平台 Agent 时用这个基础 URL（不要用 localhost）
# 例：https://agent.mycompany.com 或 http://1.2.3.4:8900
AWS_A2A_PUBLIC_BASE_URL=
